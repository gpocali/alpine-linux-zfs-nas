#!/bin/ash

CONFIG_DIR="/etc/remote-backups"
CRON_FILE="/etc/crontabs/root"
CHANGES_PENDING=0

mkdir -p "$CONFIG_DIR"

# ==========================================
# Self-Healing Dependency Checks
# ==========================================
if ! apk info -e cifs-utils rsync tpm2-tools >/dev/null 2>&1; then
    clear
    echo "⚙️  First Run Detected: Installing required backup dependencies..."
    apk add cifs-utils rsync tpm2-tools
    
    echo "⚙️  Ensuring cron daemon is registered to start on boot..."
    rc-update add crond default >/dev/null 2>&1
    rc-service crond start >/dev/null 2>&1
    
    echo "✅ Remote backup dependencies installed and configured successfully."
    sleep 2
fi

prompt_cron_schedule() {
    echo ""
    echo "Select Backup Frequency:"
    echo "  1) Hourly  (0 * * * *)"
    echo "  2) Daily   (0 0 * * *)"
    echo "  3) Weekly  (0 0 * * 0)"
    echo "  4) Custom  (Enter raw cron string)"
    printf "Choice [1-4]: "
    read CRON_CHOICE
    
    case "$CRON_CHOICE" in
        1) CRON_RESULT="0 * * * *" ;;
        2) CRON_RESULT="0 0 * * *" ;;
        3) CRON_RESULT="0 0 * * 0" ;;
        4)
            printf "Enter raw cron interval (e.g., '0 */2 * * *'): "
            read CRON_RESULT
            ;;
        *)
            echo "❌ Invalid selection. Defaulting to Daily."
            CRON_RESULT="0 0 * * *"
            ;;
    esac
}

show_menu() {
    clear
    echo "=========================================================================="
    echo "                 Remote SMB Backup Manager      "
    echo "=========================================================================="
    
    # Dashboard: Inline listing of all active jobs
    if [ -z "$(ls -A $CONFIG_DIR 2>/dev/null)" ]; then
        echo "  (No backup jobs configured)"
    else
        for dir in "$CONFIG_DIR"/*; do
            [ -d "$dir" ] || continue
            LOCAL_ALIAS=$(basename "$dir")
            SMB_PATH=""
            SMB_USER=""
            DESTINATION=""
            [ -f "$dir/config.sh" ] && source "$dir/config.sh"
            LOCAL_CRON_SCHED=$(grep "/remote-backup-worker $LOCAL_ALIAS" "$CRON_FILE" 2>/dev/null | awk '{print $1,$2,$3,$4,$5}')
            
            LOG_FILE="/var/log/remote-backup-${LOCAL_ALIAS}.log"
            if [ -f "$LOG_FILE" ]; then
                # Fetch last modified time of the log file using stat
                LAST_RUN=$(stat -c "%y" "$LOG_FILE" 2>/dev/null | cut -d'.' -f1)
                # Fetch the last line of the log for a quick status snippet
                STATUS=$(tail -n 1 "$LOG_FILE" | tr -d '\n' | cut -c 1-60)
            else
                LAST_RUN="Never"
                STATUS="Pending first execution"
            fi
            
            printf "\033[1;36m  ► %s\033[0m\n" "$LOCAL_ALIAS"
            printf "      Source : %s (User: %s)\n" "$SMB_PATH" "$SMB_USER"
            printf "      Target : %s\n" "$DESTINATION"
            printf "      Cron   : %s\n" "$LOCAL_CRON_SCHED"
            printf "      Status : %s\n" "${STATUS:-No output}"
            printf "      Updated: %s\n\n" "${LAST_RUN:-Unknown}"
        done
    fi
    
    echo "=========================================================================="
    echo "   1) Add New Remote Share Backup"
    echo "   2) Run a Backup Manually (Live Verbose Output)"
    echo "   3) Edit an Existing Backup Job"
    echo "   4) Delete a Backup Job"
    echo "   0) Exit"
    echo "=========================================================================="
    printf "Select an action [0-4]: "
}

# Dynamic Helper: Generates a numbered list of backup jobs for selection
select_backup() {
    ALIAS=""
    
    if [ -z "$(ls -A $CONFIG_DIR 2>/dev/null)" ]; then
        echo "❌ No backup jobs configured."
        return 1
    fi

    # Load the directory names into positional parameters ($1, $2, etc.)
    set -- $(ls -A "$CONFIG_DIR")
    
    i=1
    for b in "$@"; do
        echo "  $i) $b"
        i=$((i + 1))
    done
    echo "  0) Cancel"
    
    printf "Select a job [0-$#]: "
    read NUM_CHOICE

    if [ "$NUM_CHOICE" = "0" ]; then
        return 1
    fi

    # Validate the input is an integer and within the valid range
    if ! [ "$NUM_CHOICE" -eq "$NUM_CHOICE" ] 2>/dev/null || [ "$NUM_CHOICE" -lt 1 ] || [ "$NUM_CHOICE" -gt "$#" ]; then
        echo "❌ Invalid selection."
        return 1
    fi

    # Dynamically extract the selected alias
    eval ALIAS=\${$NUM_CHOICE}
    return 0
}

add_backup() {
    echo ""
    printf "Enter a short alias for this share (e.g., proxmox_vms, docs): "
    read ALIAS
    
    if echo "$ALIAS" | grep -Eq '[^a-zA-Z0-9_-]'; then
        echo "❌ Error: Alias can only contain letters, numbers, dashes, and underscores."
        sleep 2; return
    fi
    
    if [ -d "$CONFIG_DIR/$ALIAS" ]; then
        echo "❌ Error: Backup job '$ALIAS' already exists."
        sleep 2; return
    fi

    printf "Enter SMB Path (e.g., //10.0.0.5/docs): "
    read SMB_PATH
    
    printf "Enter SMB Username: "
    read SMB_USER
    
    stty -echo
    printf "Enter SMB Password (will be sealed in TPM): "
    read SMB_PASS
    stty echo
    printf "\n"

    printf "Enter local ZFS destination dataset/path (e.g., /vaultpool/backups): "
    read DESTINATION
    
    prompt_cron_schedule
    CRON_INT="$CRON_RESULT"

    echo "⚙️  Sealing credentials into TPM..."
    mkdir -p "$CONFIG_DIR/$ALIAS"
    
    TMP_DIR=$(mktemp -d /dev/shm/tpm_seal_XXXXXX)
    TMP_PASS="$TMP_DIR/pass"
    PRIMARY_CTX="$TMP_DIR/primary.ctx"
    echo -n "$SMB_PASS" > "$TMP_PASS"
    
    tpm2_createprimary -c "$PRIMARY_CTX" >/dev/null 2>&1
    tpm2_create -C "$PRIMARY_CTX" -i "$TMP_PASS" -u "$CONFIG_DIR/$ALIAS/pass.pub" -r "$CONFIG_DIR/$ALIAS/pass.priv" >/dev/null 2>&1
    
    rm -rf "$TMP_DIR"
    
    cat <<EOF > "$CONFIG_DIR/$ALIAS/config.sh"
SMB_PATH="$SMB_PATH"
SMB_USER="$SMB_USER"
DESTINATION="$DESTINATION"
EOF

    echo "⚙️  Scheduling backup in crontab (queued via flock)..."
    echo "$CRON_INT flock /var/lock/remote-backup.lock /usr/local/bin/remote-backup-worker $ALIAS >> /var/log/remote-backup-${ALIAS}.log 2>&1" >> "$CRON_FILE"
    rc-service crond reload >/dev/null 2>&1
    
    echo "✅ Backup job '$ALIAS' successfully provisioned."
    CHANGES_PENDING=1
    sleep 2
}

run_manual_backup() {
    echo ""
    echo "--- Manual Backup Execution ---"
    
    if ! select_backup; then
        sleep 2; return
    fi

    echo ""
    echo "=========================================================================="
    echo " 🚀 Executing live synchronization for: $ALIAS"
    echo "    (Waiting for queue lock if another backup is running...)"
    echo "=========================================================================="
    
    # Execute the worker sequentially using flock to prevent collision with automated tasks
    flock /var/lock/remote-backup.lock /usr/local/bin/remote-backup-worker "$ALIAS" verbose
    
    echo "=========================================================================="
    printf "\nPress Enter to return to the menu..."
    read DUMMY
}

edit_backup() {
    echo ""
    echo "--- Edit Backup Job ---"
    
    if ! select_backup; then
        sleep 2; return
    fi

    while true; do
        source "$CONFIG_DIR/$ALIAS/config.sh"
        CRON_SCHED=$(grep "/remote-backup-worker $ALIAS" "$CRON_FILE" | awk '{print $1,$2,$3,$4,$5}')

        clear
        echo "=========================================================================="
        echo " Editing Backup Job: $ALIAS"
        echo "=========================================================================="
        echo " 1) SMB Path       [Current: $SMB_PATH]"
        echo " 2) SMB Username   [Current: $SMB_USER]"
        echo " 3) SMB Password   [Current: (Sealed in TPM)]"
        echo " 4) Destination    [Current: $DESTINATION]"
        echo " 5) Cron Interval  [Current: $CRON_SCHED]"
        echo " 0) Return to Main Menu"
        echo "=========================================================================="
        printf "Select an aspect to edit [0-5]: "
        read EDIT_OPT

        case "$EDIT_OPT" in
            1)
                printf "Enter new SMB Path: "
                read NEW_VAL
                if [ -n "$NEW_VAL" ]; then
                    sed -i "s|^SMB_PATH=.*|SMB_PATH=\"$NEW_VAL\"|" "$CONFIG_DIR/$ALIAS/config.sh"
                    CHANGES_PENDING=1
                    echo "✅ SMB Path updated."
                fi
                sleep 1
                ;;
            2)
                printf "Enter new SMB Username: "
                read NEW_VAL
                if [ -n "$NEW_VAL" ]; then
                    sed -i "s|^SMB_USER=.*|SMB_USER=\"$NEW_VAL\"|" "$CONFIG_DIR/$ALIAS/config.sh"
                    CHANGES_PENDING=1
                    echo "✅ SMB Username updated."
                fi
                sleep 1
                ;;
            3)
                stty -echo
                printf "Enter new SMB Password: "
                read NEW_VAL
                stty echo
                printf "\n"
                if [ -n "$NEW_VAL" ]; then
                    echo "⚙️  Resealing new credentials into TPM..."
                    TMP_DIR=$(mktemp -d /dev/shm/tpm_seal_XXXXXX)
                    TMP_PASS="$TMP_DIR/pass"
                    PRIMARY_CTX="$TMP_DIR/primary.ctx"
                    echo -n "$NEW_VAL" > "$TMP_PASS"
                    tpm2_createprimary -c "$PRIMARY_CTX" >/dev/null 2>&1
                    tpm2_create -C "$PRIMARY_CTX" -i "$TMP_PASS" -u "$CONFIG_DIR/$ALIAS/pass.pub" -r "$CONFIG_DIR/$ALIAS/pass.priv" >/dev/null 2>&1
                    rm -rf "$TMP_DIR"
                    CHANGES_PENDING=1
                    echo "✅ SMB Password updated."
                fi
                sleep 1
                ;;
            4)
                printf "Enter new local ZFS destination: "
                read NEW_VAL
                if [ -n "$NEW_VAL" ]; then
                    sed -i "s|^DESTINATION=.*|DESTINATION=\"$NEW_VAL\"|" "$CONFIG_DIR/$ALIAS/config.sh"
                    CHANGES_PENDING=1
                    echo "✅ Destination updated."
                fi
                sleep 1
                ;;
            5)
                prompt_cron_schedule
                if [ -n "$CRON_RESULT" ]; then
                    grep -v "/remote-backup-worker $ALIAS" "$CRON_FILE" > "${CRON_FILE}.tmp"
                    mv "${CRON_FILE}.tmp" "$CRON_FILE"
                    echo "$CRON_RESULT flock /var/lock/remote-backup.lock /usr/local/bin/remote-backup-worker $ALIAS >> /var/log/remote-backup-${ALIAS}.log 2>&1" >> "$CRON_FILE"
                    rc-service crond reload >/dev/null 2>&1
                    CHANGES_PENDING=1
                    echo "✅ Cron interval updated."
                fi
                sleep 1
                ;;
            0)
                break
                ;;
            *)
                echo "❌ Invalid selection."
                sleep 1
                ;;
        esac
    done
}

delete_backup() {
    echo ""
    echo "--- Delete Backup Job ---"
    
    if ! select_backup; then
        sleep 2; return
    fi

    echo ""
    printf "⚠️  Are you sure you want to delete '%s'? [y/N]: " "$ALIAS"
    read CONFIRM
    
    if [ "$CONFIRM" = "y" ] || [ "$CONFIRM" = "Y" ]; then
        echo "🧹 Removing configuration and crontab entries..."
        rm -rf "$CONFIG_DIR/$ALIAS"
        grep -v "/remote-backup-worker $ALIAS" "$CRON_FILE" > "${CRON_FILE}.tmp"
        mv "${CRON_FILE}.tmp" "$CRON_FILE"
        rc-service crond reload >/dev/null 2>&1
        
        echo "✅ Backup job '$ALIAS' deleted."
        CHANGES_PENDING=1
    else
        echo "❌ Deletion canceled."
    fi
    sleep 2
}

# Core Operational Loop
while true; do
    show_menu
    read OPTION

    case "$OPTION" in
        1) add_backup ;;
        2) run_manual_backup ;;
        3) edit_backup ;;
        4) delete_backup ;;
        0) 
            echo ""
            if [ "$CHANGES_PENDING" -eq 1 ]; then
                printf "\033[1;33m⚠️  MEMORY WARNING: You made structural changes during this session.\033[0m\n"
                printf "\033[1;37m   You MUST run 'lbu commit -d' to permanently save them to your boot media!\033[0m\n\n"
            fi
            echo "Exiting."
            exit 0 
            ;;
        *) 
            echo "❌ Invalid selection."
            sleep 1 
            ;;
    esac
done