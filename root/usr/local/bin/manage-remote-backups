#!/bin/ash

CONFIG_DIR="/etc/remote-backups"
CRON_FILE="/etc/crontabs/root"
CHANGES_PENDING=0

mkdir -p "$CONFIG_DIR"

# ==========================================
# Self-Healing Dependency Checks
# ==========================================
if ! apk info -e cifs-utils rsync tpm2-tools >/dev/null 2>&1; then
    clear
    echo "⚙️  First Run Detected: Installing required backup dependencies..."
    apk add cifs-utils rsync tpm2-tools
    
    echo "⚙️  Ensuring cron daemon is registered to start on boot..."
    rc-update add crond default >/dev/null 2>&1
    rc-service crond start >/dev/null 2>&1
    
    echo "✅ Remote backup dependencies installed and configured successfully."
    sleep 2
fi

show_menu() {
    clear
    echo "=========================================================================="
    echo "                 Remote SMB Backup Manager      "
    echo "=========================================================================="
    echo "   1) Add New Remote Share Backup"
    echo "   2) List Configured Backups"
    echo "   3) Run a Backup Manually (Live Verbose Output)"
    echo "   4) Delete a Backup Job"
    echo "   0) Exit"
    echo "=========================================================================="
    printf "Select an action [0-4]: "
}

# Dynamic Helper: Generates a numbered list of backup jobs for selection
select_backup() {
    ALIAS=""
    
    if [ -z "$(ls -A $CONFIG_DIR 2>/dev/null)" ]; then
        echo "❌ No backup jobs configured."
        return 1
    fi

    # Load the directory names into positional parameters ($1, $2, etc.)
    set -- $(ls -A "$CONFIG_DIR")
    
    i=1
    for b in "$@"; do
        echo "  $i) $b"
        i=$((i + 1))
    done
    echo "  0) Cancel"
    
    printf "Select a job [0-$#]: "
    read NUM_CHOICE

    if [ "$NUM_CHOICE" = "0" ]; then
        return 1
    fi

    # Validate the input is an integer and within the valid range
    if ! [ "$NUM_CHOICE" -eq "$NUM_CHOICE" ] 2>/dev/null || [ "$NUM_CHOICE" -lt 1 ] || [ "$NUM_CHOICE" -gt "$#" ]; then
        echo "❌ Invalid selection."
        return 1
    fi

    # Dynamically extract the selected alias
    eval ALIAS=\${$NUM_CHOICE}
    return 0
}

add_backup() {
    echo ""
    printf "Enter a short alias for this share (e.g., proxmox_vms, docs): "
    read ALIAS
    
    if echo "$ALIAS" | grep -Eq '[^a-zA-Z0-9_-]'; then
        echo "❌ Error: Alias can only contain letters, numbers, dashes, and underscores."
        sleep 2; return
    fi
    
    if [ -d "$CONFIG_DIR/$ALIAS" ]; then
        echo "❌ Error: Backup job '$ALIAS' already exists."
        sleep 2; return
    fi

    printf "Enter SMB Path (e.g., //10.0.0.5/docs): "
    read SMB_PATH
    
    printf "Enter SMB Username: "
    read SMB_USER
    
    stty -echo
    printf "Enter SMB Password (will be sealed in TPM): "
    read SMB_PASS
    stty echo
    printf "\n"

    printf "Enter local ZFS destination dataset/path (e.g., /vaultpool/backups): "
    read DESTINATION
    
    printf "Enter cron interval (e.g., '0 * * * *' for hourly): "
    read CRON_INT

    echo "⚙️  Sealing credentials into TPM..."
    mkdir -p "$CONFIG_DIR/$ALIAS"
    
    TMP_PASS=$(mktemp /dev/shm/pass_XXXXXX)
    echo -n "$SMB_PASS" > "$TMP_PASS"
    
    tpm2_createprimary -c primary.ctx 2>/dev/null
    tpm2_create -C primary.ctx -i "$TMP_PASS" -u "$CONFIG_DIR/$ALIAS/pass.pub" -r "$CONFIG_DIR/$ALIAS/pass.priv"
    
    rm -f "$TMP_PASS" primary.ctx
    
    cat <<EOF > "$CONFIG_DIR/$ALIAS/config.sh"
SMB_PATH="$SMB_PATH"
SMB_USER="$SMB_USER"
DESTINATION="$DESTINATION"
EOF

    echo "⚙️  Scheduling backup in crontab..."
    echo "$CRON_INT /usr/local/bin/remote-backup-worker $ALIAS >> /var/log/remote-backup-${ALIAS}.log 2>&1" >> "$CRON_FILE"
    rc-service crond reload >/dev/null 2>&1
    
    echo "✅ Backup job '$ALIAS' successfully provisioned."
    CHANGES_PENDING=1
    sleep 2
}

list_backups() {
    echo ""
    echo "--- Active Backup Jobs ---"
    if [ -z "$(ls -A $CONFIG_DIR 2>/dev/null)" ]; then
        echo "  (No backup jobs configured)"
    else
        for dir in "$CONFIG_DIR"/*; do
            [ -d "$dir" ] || continue
            ALIAS=$(basename "$dir")
            source "$dir/config.sh"
            CRON_SCHED=$(grep "/remote-backup-worker $ALIAS" "$CRON_FILE" | awk '{print $1,$2,$3,$4,$5}')
            
            printf "\033[1;36m  ► %s\033[0m\n" "$ALIAS"
            printf "      Source : %s (User: %s)\n" "$SMB_PATH" "$SMB_USER"
            printf "      Target : %s\n" "$DESTINATION"
            printf "      Cron   : %s\n\n" "$CRON_SCHED"
        done
    fi
    printf "Press Enter to return..."
    read DUMMY
}

run_manual_backup() {
    echo ""
    echo "--- Manual Backup Execution ---"
    
    if ! select_backup; then
        sleep 2; return
    fi

    echo ""
    echo "=========================================================================="
    echo " 🚀 Executing live synchronization for: $ALIAS"
    echo "=========================================================================="
    
    # Execute the worker in the foreground with the "verbose" flag
    /usr/local/bin/remote-backup-worker "$ALIAS" verbose
    
    echo "=========================================================================="
    printf "\nPress Enter to return to the menu..."
    read DUMMY
}

delete_backup() {
    echo ""
    echo "--- Delete Backup Job ---"
    
    if ! select_backup; then
        sleep 2; return
    fi

    echo ""
    printf "⚠️  Are you sure you want to delete '%s'? [y/N]: " "$ALIAS"
    read CONFIRM
    
    if [ "$CONFIRM" = "y" ] || [ "$CONFIRM" = "Y" ]; then
        echo "🧹 Removing configuration and crontab entries..."
        rm -rf "$CONFIG_DIR/$ALIAS"
        grep -v "/remote-backup-worker $ALIAS" "$CRON_FILE" > "${CRON_FILE}.tmp"
        mv "${CRON_FILE}.tmp" "$CRON_FILE"
        rc-service crond reload >/dev/null 2>&1
        
        echo "✅ Backup job '$ALIAS' deleted."
        CHANGES_PENDING=1
    else
        echo "❌ Deletion canceled."
    fi
    sleep 2
}

# Core Operational Loop
while true; do
    show_menu
    read OPTION

    case "$OPTION" in
        1) add_backup ;;
        2) list_backups ;;
        3) run_manual_backup ;;
        4) delete_backup ;;
        0) 
            echo ""
            if [ "$CHANGES_PENDING" -eq 1 ]; then
                printf "\033[1;33m⚠️  MEMORY WARNING: You made structural changes during this session.\033[0m\n"
                printf "\033[1;37m   You MUST run 'lbu commit -d' to permanently save them to your boot media!\033[0m\n\n"
            fi
            echo "Exiting."
            exit 0 
            ;;
        *) 
            echo "❌ Invalid selection."
            sleep 1 
            ;;
    esac
done