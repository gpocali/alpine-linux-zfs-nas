#!/usr/bin/env python3
import os
import http.server
import socketserver
import json
import subprocess

ENV_PATH = "/etc/nas-commander.env"

def load_key():
    if not os.path.exists(ENV_PATH):
        return None
    try:
        with open(ENV_PATH, 'r') as f:
            for line in f:
                if line.startswith("COMMANDER_API_KEY="):
                    return line.strip().split("=")[1]
    except:
        pass
    return None

EXPECTED_KEY = load_key()

class CommanderHandler(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        # 1. Validate API Key
        auth_header = self.headers.get('Authorization')
        if not auth_header or auth_header != f"Bearer {EXPECTED_KEY}":
            self.send_response(401)
            self.end_headers()
            self.wfile.write(b'{"error": "Unauthorized"}')
            return

        # 2. Parse Request
        content_length = int(self.headers['Content-Length'])
        post_data = self.rfile.read(content_length)
        try:
            data = json.loads(post_data)
        except:
            self.send_response(400)
            self.end_headers()
            self.wfile.write(b'{"error": "Invalid JSON"}')
            return

        command = data.get("command")
        args = data.get("args", [])

        # 3. Dispatch Command
        print(f"Executing: {command} with {args}")

        # Security: Only allow specific script calls
        cmd_map = {
            "manage_shares": "/usr/local/bin/manage-shares",
            "generate_telemetry": "/usr/local/bin/generate-telemetry",
            "zfs_snapshot": "/usr/local/bin/zfs_snapshot",
            "delete_dataset": "/usr/local/bin/delete_dataset"
        }

        if command not in cmd_map:
            self.send_response(400)
            self.end_headers()
            self.wfile.write(json.dumps({"error": "Unknown command"}).encode())
            return

        full_path = cmd_map[command]
        
        try:
            result = subprocess.run([full_path] + args, capture_output=True, text=True, timeout=10)
            response_data = {
                "exit_code": result.returncode,
                "stdout": result.stdout,
                "stderr": result.stderr
            }
            status = 200 if result.returncode == 0 else 500
        except Exception as e:
            status = 500
            response_data = {"error": str(e)}

        self.send_response(status)
        self.send_header('Content-Type', 'application/json')
        self.end_headers()
        self.wfile.write(json.dumps(response_data).encode())

    def do_GET(self):
        # Simple health check
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b'{"status": "running"}')

if __name__ == "__main__":
    if not EXPECTED_KEY:
        print("FATAL: No API key found in /etc/nas-commander.env. Run nas-keytool generate first.")
        exit(1)

    PORT = 8080
    with socketserver.TCPServer(("", PORT), CommanderHandler) as httpd:
        print(f"Commander Service running on port {PORT}")
        httpd.serve_forever()
