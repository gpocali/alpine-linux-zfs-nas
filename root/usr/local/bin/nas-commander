#!/usr/bin/env python3
import os
import http.server
import socketserver
import json
import subprocess

ENV_PATH = "/etc/nas-commander.env"
PORT = 8081


def load_key():
    if not os.path.exists(ENV_PATH):
        return None
    try:
        with open(ENV_PATH, "r") as f:
            for line in f:
                if line.startswith("COMMANDER_API_KEY="):
                    return line.strip().split("=", 1)[1]
    except Exception:
        pass
    return None


class CommanderHandler(http.server.BaseHTTPRequestHandler):
    def _send_json(self, status_code, payload):
        self.send_response(status_code)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps(payload).encode("utf-8"))

    def do_POST(self):
        # 1. Validate API Key (reloaded dynamically to support nas-keytool rotate)
        expected_key = load_key()
        auth_header = self.headers.get("Authorization")
        if not expected_key or not auth_header or auth_header != f"Bearer {expected_key}":
            self._send_json(401, {"error": "Unauthorized"})
            return

        # 2. Parse Request
        try:
            content_length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            self._send_json(400, {"error": "Invalid Content-Length"})
            return

        post_data = self.rfile.read(content_length) if content_length > 0 else b""
        try:
            data = json.loads(post_data)
        except Exception:
            self._send_json(400, {"error": "Invalid JSON"})
            return

        if not isinstance(data, dict):
            self._send_json(400, {"error": "JSON body must be an object"})
            return

        command = data.get("command")
        args = data.get("args", [])
        if not isinstance(args, list):
            self._send_json(400, {"error": "'args' must be a list"})
            return
        args = [str(a) for a in args]

        # 3. Dispatch Command
        print(f"Executing: {command} with {args}")

        # Security: Only allow specific non-interactive script calls
        cmd_map = {
            "manage_shares": ["/usr/local/bin/manage-shares"],
            "generate_telemetry": ["/usr/local/bin/generate-telemetry"],
            "zfs_snapshot": ["/usr/local/bin/manage-shares", "--snapshot"],
            "delete_dataset": ["/usr/local/bin/manage-shares", "--delete-dataset"],
            "zfs_autokeeper": ["/usr/local/bin/zfs-autokeeper"],
            "array_control": ["/usr/local/bin/array-control"],
            "cache_mover": ["/usr/local/bin/cache-mover.sh"],
            "remote_backup": ["/usr/local/bin/remote-backup-worker"],
        }

        if command not in cmd_map:
            self._send_json(400, {"error": "Unknown command"})
            return

        base_cmd = cmd_map[command]
        # Default manage_shares to --list when called via API without arguments
        if command == "manage_shares" and not args:
            args = ["--list"]

        try:
            result = subprocess.run(
                base_cmd + args,
                capture_output=True,
                text=True,
                timeout=30,
            )
            response_data = {
                "exit_code": result.returncode,
                "stdout": result.stdout,
                "stderr": result.stderr,
            }
            status = 200 if result.returncode == 0 else 500
        except Exception as e:
            status = 500
            response_data = {"error": str(e)}

        self._send_json(status, response_data)

    def do_GET(self):
        # Simple health check
        self._send_json(200, {"status": "running", "port": PORT})


if __name__ == "__main__":
    if not load_key():
        print("FATAL: No API key found in /etc/nas-commander.env. Run nas-keytool generate first.")
        exit(1)

    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("", PORT), CommanderHandler) as httpd:
        print(f"Commander Service running on port {PORT}")
        httpd.serve_forever()
