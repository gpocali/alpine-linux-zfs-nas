#!/usr/bin/env python3
import os
import secrets
import string
import sys

ENV_PATH = "/etc/nas-commander.env"


def generate_key():
    alphabet = string.ascii_letters + string.digits
    new_key = "".join(secrets.choice(alphabet) for _ in range(32))

    try:
        # Ensure directory exists
        os.makedirs(os.path.dirname(ENV_PATH), exist_ok=True)

        # Write key with restricted permissions
        mode = 0o600
        fd = os.open(ENV_PATH, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, mode)
        with os.fdopen(fd, "w") as f:
            f.write(f"COMMANDER_API_KEY={new_key}\n")

        print(f"SUCCESS: New key generated and saved to {ENV_PATH}")
        print(f"YOUR_NEW_KEY: {new_key}")
        print("\nIMPORTANT: Keep this key secure. You will need it to authenticate with nas-commander.")
    except Exception as e:
        print(f"ERROR: Failed to write key file: {e}")
        sys.exit(1)


def rotate():
    print("Rotating key...")
    generate_key()


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: nas-keytool [generate | rotate]")
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "generate":
        generate_key()
    elif cmd == "rotate":
        rotate()
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)
